# Optional. Homestead stores provider keys in data/store.json from the Settings UI.
# You can also export them in the environment if you prefer.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional Notion CRM sync (LinkedIn sends and prospects). Leave unset to keep everything local.
# CREW_NOTION_TOKEN=            (or CREW_NOTION_TOKEN_FILE=/path/to/token)
# CREW_NOTION_CRM_DATABASE_ID=  (the 32-character ID of your own Notion database)

# Optional comms agent (WhatsApp + Gmail drafts, github.com/RenegadeRadio/DeepSeek-Agent).
# Shows its drafts in the Comms tab with Send / Skip / Redo. The approve token can send
# messages as you, so it stays in this server's environment and never reaches Bots.
# COMMS_AGENT_URL=http://127.0.0.1:8000
# COMMS_AGENT_APPROVE_TOKEN=
